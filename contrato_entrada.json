{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Perfil ciudadano para orientación OPEC",
  "type": "object",
  "required": ["formaciones", "experiencias"],
  "properties": {
    "formaciones": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["nivel", "titulo"], "properties": {"nivel": {"type": "string", "minLength": 1}, "titulo": {"type": "string", "minLength": 1}}}},
    "experiencias": {"type": "array", "items": {"type": "object", "required": ["cargo", "fecha_inicio", "tipo"], "properties": {"cargo": {"type": "string", "minLength": 1}, "empresa": {"type": "string"}, "funciones": {"type": "string"}, "tipo": {"type": "string"}, "fecha_inicio": {"type": "string", "format": "date"}, "fecha_fin": {"type": ["string", "null"], "format": "date"}}}},
    "top_n": {"type": "integer", "minimum": 1, "maximum": 100}
  }
}
