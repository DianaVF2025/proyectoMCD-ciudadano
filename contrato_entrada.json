{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Perfil ciudadano para orientación OPEC",
  "description": "Contrato de entrada del prototipo orientado al ciudadano. Requiere al menos una formación académica; la experiencia laboral puede estar vacía.",
  "type": "object",
  "required": ["formaciones", "experiencias"],
  "properties": {
    "formaciones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nivel", "titulo"],
        "properties": {
          "nivel": {
            "type": "string",
            "enum": [
              "EDUCACION BASICA PRIMARIA",
              "EDUCACION BASICA SECUNDARIA",
              "BACHILLER",
              "NORMALISTA",
              "TECNICO PROFESIONAL",
              "TECNOLOGICO",
              "PROFESIONAL",
              "ESPECIALIZACION TECNICA PROFESIONAL",
              "ESPECIALIZACION TECNOLOGICA",
              "ESPECIALIZACION PROFESIONAL",
              "MAESTRIA",
              "DOCTORADO",
              "POSTDOCTORADO",
              "EDUCACION INFORMAL",
              "FORMACION LABORAL",
              "FORMACION PENITENCIARIA"
            ]
          },
          "titulo": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "experiencias": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cargo", "fecha_inicio", "tipo"],
        "properties": {
          "cargo": {"type": "string", "minLength": 1},
          "empresa": {"type": "string"},
          "funciones": {"type": "string"},
          "tipo": {
            "type": "string",
            "enum": [
              "Profesional",
              "Profesional relacionada",
              "Profesional específica",
              "Relacionada",
              "Específica",
              "Docente",
              "Laboral",
              "Otra"
            ]
          },
          "fecha_inicio": {"type": "string", "format": "date"},
          "fecha_fin": {
            "anyOf": [
              {"type": "string", "format": "date"},
              {"type": "null"}
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "top_n": {"type": "integer", "minimum": 1, "maximum": 100}
  },
  "additionalProperties": true
}
